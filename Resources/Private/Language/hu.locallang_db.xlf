    <header/>
    <body>
      <trans-unit id="plugin.mediapool.recommended.title">
        <source>List recommended videos</source>
        <target state="translated">Ajánlott videók listázása</target>
      </trans-unit>
      <trans-unit id="plugin.mediapool.recommended.description">
        <source>Shows a list of selected recommended videos.</source>
        <target state="translated">A kiválasztott ajánlott videók listáját jeleníti meg.</target>
      </trans-unit>
      <trans-unit id="plugin.mediapool.detail.title">
        <source>Detail view (Video, Playlist)</source>
        <target state="translated">Részletnézet (Videó, Lejátszási lista)</target>
      </trans-unit>
      <trans-unit id="plugin.mediapool.detail.description">
        <source>Shows the detailed view of a video or a playlist.</source>
        <target state="translated">Egy videó vagy lejátszási lista részletes nézetét jeleníti meg.</target>
      </trans-unit>
      <trans-unit id="plugin.mediapool.recentbycategory.title">
        <source>List recent video of playlist (category)</source>
        <target state="translated">A lejátszási lista (kategória) legutóbbi videójának listázása</target>
      </trans-unit>
      <trans-unit id="plugin.mediapool.recentbycategory.description">
        <source>Displays a list of recently added videos.</source>
        <target state="translated">A legutóbb hozzáadott videók listáját jeleníti meg.</target>
      </trans-unit>
      <trans-unit id="plugin.mediapool.latest.title">
        <source>List latest videos by playlist</source>
        <target state="translated">Legújabb videók listázása lejátszási lista szerint</target>
      </trans-unit>
      <trans-unit id="plugin.mediapool.latest.description">
        <source>Displays a list of the most recently uploaded playlists.</source>
        <target state="translated">A legutóbb feltöltött lejátszási listák listáját jeleníti meg.</target>
      </trans-unit>
      <trans-unit id="plugin.mediapool.list.title">
        <source>List all videos by playlist</source>
        <target state="translated">Összes videó listázása lejátszási lista szerint</target>
      </trans-unit>
      <trans-unit id="plugin.mediapool.list.description">
        <source>Displays a list of all available playlists.</source>
        <target state="translated">Az összes elérhető lejátszási lista listáját jeleníti meg.</target>
      </trans-unit>
      <trans-unit id="plugin.gallery.preview.title">
        <source>Gallery Preview</source>
        <target state="translated">Galéria Előnézet</target>
      </trans-unit>
      <trans-unit id="plugin.gallery.preview.description">
        <source>Displays a preview image for each selected file collection, which starts the gallery as a picture gallery when clicked.</source>
        <target state="translated">Minden kiválasztott fájlgyűjteményhez előnézeti képet jelenít meg, amelyre kattintva a galéria képgalériaként indul el.</target>
      </trans-unit>
      <trans-unit id="plugin.gallery.teaser.title">
        <source>Gallery Teaser</source>
        <target state="translated">Galéria Teaser</target>
      </trans-unit>
      <trans-unit id="plugin.gallery.teaser.description">
        <source>Use this plugin to display a reduced selection of file collections. You can use a link to refer to a page for the complete display with the Gallery: Preview plugin.</source>
        <target state="translated">Ezzel a pluginnal a fájlgyűjtemények csökkentett kínálatát jelenítheti meg. A teljes megjelenítéshez a Galéria: Előnézet pluginnal ellátott oldalra mutató hivatkozást használhat.</target>
      </trans-unit>
      <trans-unit id="tx_mediapool_domain_model_playlist">
        <source>Playlist</source>
        <target state="translated">Lejátszási lista</target>
      </trans-unit>
