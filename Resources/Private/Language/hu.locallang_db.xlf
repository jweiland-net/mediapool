        <source>Title</source>
        <target state="translated">Cím</target>
      </trans-unit>
      <trans-unit id="tx_mediapool_domain_model_video.description">
        <source>Description</source>
        <target state="translated">Leírás</target>
      </trans-unit>
      <trans-unit id="tx_mediapool_domain_model_video.upload_date">
        <source>Upload date</source>
        <target state="translated">Feltöltés dátuma</target>
      </trans-unit>
      <trans-unit id="tx_mediapool_domain_model_video.link">
        <source>Video URL</source>
