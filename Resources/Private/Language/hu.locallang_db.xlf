      </trans-unit>
      <trans-unit id="tx_mediapool_domain_model_video.empty_field">
        <source>This field will be filled automatically after first successful save.</source>
        <target state="translated">Ez a mező az első sikeres mentés után automatikusan kitöltésre kerül.</target>
      </trans-unit>
